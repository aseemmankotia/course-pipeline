# ── Anthropic API (primary) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Google Gemini API (fallback — free tier available) ────────────────────────
# Used automatically when Anthropic returns a credit/balance error.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza-your-gemini-key-here

# ── YouTube Data API v3 (for publishing) ──────────────────────────────────────
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# ── Course platform URLs (used by promo-render.js for URL overlay) ───────────
# Can also be set via --url= CLI arg or ⚙️ Settings → Course URLs in the app.
COURSE_UDEMY_URL=https://www.udemy.com/course/your-course/

# ── HeyGen avatar videos ──────────────────────────────────────────────────────
# No env var needed — export videos from HeyGen as heygen-chapter-NN.mp4 and
# place in one of:
#   render/chapters/chapter-NN/heygen-chapter-NN.mp4   (preferred)
#   ~/Downloads/heygen-chapter-NN.mp4                  (auto-detected fallback)

# ---- Marketing: email digest (scripts/build-campaign.js + send-campaign.js) ----
EMAIL_PROVIDER=brevo                   # brevo (RECOMMENDED, bulk campaign to a Brevo list) | resend | smtp
EMAIL_FROM=news@technuggets.academy    # must be a VERIFIED Brevo sender (run: node scripts/brevo-setup.js)
EMAIL_FROM_NAME=TechNuggets Academy
PHYSICAL_ADDRESS=TechNuggets Academy, <your postal address>   # REQUIRED by CAN-SPAM (shown in footer)
SEND_THROTTLE_MS=400

# brevo (default) — contacts live in Brevo; unsubscribe + address footer handled by Brevo:
BREVO_API_KEY=                         # Brevo → SMTP & API → API Keys (starts with "xkeysib-")
BREVO_LIST_ID=                         # numeric list id — get it from: node scripts/brevo-setup.js
BREVO_LIST_NAME=TechNuggets Newsletter # list to create/use if BREVO_LIST_ID not set yet

# resend only:
RESEND_API_KEY=
# resend/smtp only (brevo manages its own unsubscribe): token appended per recipient
UNSUBSCRIBE_BASE_URL=https://your-host/unsubscribe
# smtp only (also works with Brevo's SMTP relay: smtp-relay.brevo.com):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Marketing: subscribe form → Brevo (marketing/email/subscribe-worker/, Cloudflare) ----
# Bake the deployed Worker URL into the static site at build time:
# SUBSCRIBE_ENDPOINT=https://technuggets-subscribe.<sub>.workers.dev/subscribe
# (Legacy self-hosted server.js still exists; these are only for that path.)
PORT=8787
ALLOWED_ORIGIN=https://technuggets.academy
BRAND_URL=https://technuggets.academy

# ---- Marketing: WhatsApp (scaffold; opt-in + approved template only) ----
WHATSAPP_ENABLED=false                # must be true to send; requires verified Meta business + approved template
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=                    # name of your Meta-approved marketing template
WHATSAPP_LANG=en_US
WHATSAPP_API_VERSION=v20.0

# ---- Marketing domain / DNS (scripts/setup-dns.js — Porkbun API) ----
MARKETING_DOMAIN=technuggets.academy
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# --- Udemy API (practice-test loader + future publish automation) ---
# Capture once from a logged-in instructor tab: DevTools -> Network -> any api-2.0
# request -> Request Headers -> copy the whole `cookie:` value. See scripts/udemy/README.md.
UDEMY_COOKIE="access_token=...; client_id=...; csrftoken=..."
UDEMY_BASE=https://www.udemy.com

# --- TTS reliability (edge-tts free endpoint) ---
# Max characters per edge-tts request. The free Microsoft endpoint can wedge/timeout
# on large single requests; smaller chunks are far more reliable. Default 2400; 1600
# recommended. Set in your local .env. Also run narration serially (--jobs=1) if the
# endpoint is flaky.
EDGE_CHUNK_CHARS=1600
